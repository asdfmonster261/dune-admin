# Node
web/node_modules/

# Frontend build output is generated by the Dockerfile's web-builder stage.
# Keep the directory tracked so go:embed has a valid target at compile time,
# but ignore the actual outputs locally.
web/dist/*
!web/dist/.gitkeep

# Go build cache
.go-cache/

# Macports / linux compiled outputs
*.so
*.dylib
*.a
