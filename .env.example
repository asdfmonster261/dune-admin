# dune-admin configuration. Defaults work for the integrated docker-compose
# deployment (sibling service on dune-server's compose network).

# Postgres — copy POSTGRES_DUNE_PASS from dune-server's .env.
DB_HOST=postgres
DB_PORT=5432
DB_USER=dune
DB_PASS=
DB_NAME=dune
DB_SCHEMA=dune

# dune-orchestrator's K8s API emulator. Self-signed cert, so insecure verify
# is on by default.
ORCHESTRATOR_URL=https://dune-orchestrator:6443
ORCHESTRATOR_INSECURE=true

# Battlegroup namespace = funcom-seabass-<WORLD_UNIQUE_NAME>.
BATTLEGROUP_NS=

# docker-compose project label used to filter container listings.
DOCKER_PROJECT=dune-server

# HTTP server
LISTEN_ADDR=:8080

# Optional extra CORS origins (same-origin is always allowed).
ALLOWED_ORIGINS=
